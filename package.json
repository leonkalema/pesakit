{
  "name": "pesakit",
  "version": "4.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "PESAKIT_LIVE=1 vitest run test/live.test.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "pesapal",
    "pesapal-v3",
    "pesapal-api",
    "payment",
    "payments",
    "checkout",
    "mobile-money",
    "mpesa",
    "m-pesa",
    "airtel-money",
    "mtn-momo",
    "kenya",
    "uganda",
    "tanzania",
    "rwanda",
    "zambia",
    "malawi",
    "zimbabwe",
    "africa",
    "fintech",
    "ipn",
    "webhook",
    "subscription",
    "recurring",
    "refund",
    "express",
    "hono",
    "nextjs",
    "sveltekit",
    "fastify",
    "cloudflare-workers",
    "typescript"
  ],
  "author": "Leon Kalema",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1",
    "vitepress": "^1.5.0",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leonkalema/pesakit.git"
  },
  "bugs": {
    "url": "https://github.com/leonkalema/pesakit/issues"
  },
  "homepage": "https://github.com/leonkalema/pesakit#readme",
  "description": "Pesapal API 3.0 client for Node, Bun, Deno and edge runtimes. Zero dependencies. Payments, subscriptions, refunds, cancel, IPN with dedupe, framework adapters, a mock Pesapal for tests.",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js",
      "require": "./dist/fastify.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js",
      "require": "./dist/fetch.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "import": "./dist/sveltekit.js",
      "require": "./dist/sveltekit.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./checkout": {
      "types": "./dist/checkout.d.ts",
      "import": "./dist/checkout.js",
      "require": "./dist/checkout.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
