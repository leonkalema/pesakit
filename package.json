{
  "name": "pesakit",
  "version": "3.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./index.d.ts",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=integration --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "esbuild index.js --bundle --platform=node --format=cjs --packages=external --outfile=dist/index.cjs --footer:js=\"module.exports = Object.assign(module.exports.default, module.exports);\"",
    "prepublishOnly": "npm run lint && npm run test:unit && npm run build",
    "security:audit": "npm audit --audit-level moderate"
  },
  "keywords": [
    "pesapal",
    "pesapal-v3",
    "payment",
    "payments",
    "mobile-money",
    "mpesa",
    "airtel-money",
    "mtn-momo",
    "kenya",
    "uganda",
    "tanzania",
    "rwanda",
    "zambia",
    "malawi",
    "zimbabwe",
    "africa",
    "fintech",
    "ipn",
    "subscription",
    "refund"
  ],
  "author": "Leon Kalema",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "axios-retry": "^4.0.0",
    "joi": "^17.11.0",
    "node-cache": "^5.1.2",
    "opossum": "^8.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "esbuild": "^0.24.2",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.7.0",
    "nock": "^13.4.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "dist/",
    "lib/",
    "schemas/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leonkalema/pesakit.git"
  },
  "bugs": {
    "url": "https://github.com/leonkalema/pesakit/issues"
  },
  "homepage": "https://github.com/leonkalema/pesakit#readme",
  "description": "Pesapal API 3.0 client for Node.js: payments, subscriptions, refunds, cancel, IPN. Full V3 coverage, ESM and CommonJS, typed.",
  "module": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "index.js",
      "lib/**/*.js",
      "schemas/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ]
  }
}
